# climate-web — frontend environment contract
# Copy to `.env` and fill in real values. NEVER commit real secrets.
# All VITE_* vars are exposed to the browser bundle — publishable values ONLY.

# LINE Login channel ID (from LINE Developers Console → Channel → Basic settings)
VITE_LINE_CHANNEL_ID=

# OAuth callback URL registered in the LINE channel (must match exactly, e.g. https://your-domain/auth/line/callback)
VITE_LINE_REDIRECT_URI=

# Stripe publishable key (pk_live_… / pk_test_…) — never the secret key
VITE_STRIPE_PUBLISHABLE_KEY=

# Supabase project URL (https://<project-ref>.supabase.co)
VITE_SUPABASE_URL=

# Supabase anon/public key — safe for browser, protected by RLS policies
VITE_SUPABASE_ANON_KEY=
